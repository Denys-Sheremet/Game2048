<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:item="clr-namespace:Game2048.Maui.ViewModels.Items"
             x:Class="Game2048.Maui.Views.Components.HowToCardView"
             x:DataType="item:HowToCardViewModel">

    <Grid RowDefinitions="Auto, *, Auto"
          RowSpacing="20"
          HorizontalOptions="Fill"
          VerticalOptions="Center">

        <Label Grid.Row="0"
               Text="{Binding Title}"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap"
               FontSize="18"
               FontFamily="RubikBold"
               Margin="10, 0"
               TextColor="{DynamicResource MainTitleColor}" />

        <Border Grid.Row="1"
                Background="Transparent"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Image Source="{Binding ImageSource}"
                   Aspect="AspectFit"
                   MaximumHeightRequest="360"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <Label Grid.Row="2"
               Text="{Binding Description}"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Start"
               LineBreakMode="WordWrap"
               FontSize="18"
               FontFamily="RubikSemi"
               Margin="10, 0"
               TextColor="{DynamicResource SecondaryTextColor}" />
    </Grid>
    
</ContentView>
