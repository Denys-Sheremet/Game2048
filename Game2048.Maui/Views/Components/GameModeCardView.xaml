<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:Game2048.Maui.Views.Components"
             xmlns:ovr="clr-namespace:Game2048.Maui.Views.Overlays"
             xmlns:models="clr-namespace:Game2048.Maui.Models"
             x:Class="Game2048.Maui.Views.Components.GameModeCardView"
             x:DataType="models:GameMode">

    <Border x:Name="CardContainer"
            StrokeShape="RoundRectangle 32"
            StrokeThickness="3"
            Stroke="{DynamicResource MainBorderColor}"
            Background="{Binding CardColor}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="{OnIdiom Phone=300, Tablet=335}"
            MaximumWidthRequest="{OnIdiom Phone=400, Tablet=550}"
            Margin="10, 20">

        <Border.GestureRecognizers>
            <TapGestureRecognizer 
                Command="{Binding Command, Source={RelativeSource AncestorType={x:Type comp:GameModeCardView}}, x:DataType={x:Type comp:GameModeCardView}}"
                CommandParameter="{Binding CommandParameter, Source={RelativeSource AncestorType={x:Type comp:GameModeCardView}}, x:DataType={x:Type comp:GameModeCardView}}" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="*, Auto, Auto" Padding="15" RowSpacing="5">

            <Border Grid.Row="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    Background="Transparent"
                    HorizontalOptions="Center">

                <Image Source="{Binding GifSource}"
                       Aspect="AspectFit"
                       MaximumHeightRequest="{OnIdiom Phone=260, Tablet=280}"
                       MaximumWidthRequest="{OnIdiom Phone=260, Tablet=280}" />
            </Border>

            <Border Grid.Row="1"
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="2"
                    Stroke="{DynamicResource MainBorderColor}"
                    Background="{DynamicResource SecondaryFieldBGColor}"
                    HorizontalOptions="Fill">

                <Label Text="{Binding Title}" 
                       FontSize="{OnIdiom Phone=20, Tablet=24}" 
                       TextColor="{DynamicResource MainTitleColor}" 
                       FontFamily="RubikBold"
                       Margin="15, 5"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="NoWrap"/>
            </Border>

            <Border Grid.Row="2"
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="2"
                    Stroke="{DynamicResource MainBorderColor}"
                    Background="{DynamicResource SecondaryFieldBGColor}"
                    HorizontalOptions="Fill"
                    HeightRequest="{OnIdiom Phone=240, Tablet=260}">

                
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Characteristics}"
                                     Spacing="4" 
                                     Padding="15, 10"
                                     HorizontalOptions="Fill">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="•" 
                                       FontSize="{OnIdiom Phone=16, Tablet=18}" 
                                       FontFamily="RubikBold" 
                                       TextColor="{DynamicResource MainTitleColor}" 
                                       VerticalOptions="Start"/>

                                <Label Grid.Column="1"
                                       Text="{Binding .}" 
                                       FontSize="{OnIdiom Phone=16, Tablet=18}" 
                                       FontFamily="RubikSemi" 
                                       TextColor="{DynamicResource MainTitleColor}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Fill"
                                       LineBreakMode="WordWrap" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </Border>

</ContentView>
