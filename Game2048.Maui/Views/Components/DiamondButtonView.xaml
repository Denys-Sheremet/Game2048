<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:Game2048.Maui.Views.Components"
             x:Class="Game2048.Maui.Views.Components.DiamondButtonView"
             x:Name="ThisButton"
             x:DataType="comp:DiamondButtonView">
    <Border x:Name="DiamondButtonBorder"
            WidthRequest="{Binding ButtonSize, Source={x:Reference ThisButton}}"
            HeightRequest="{Binding ButtonSize, Source={x:Reference ThisButton}}"
            Stroke="{Binding StrokeColor, Source={x:Reference ThisButton}}"
            StrokeThickness="{Binding StrokeThickness, Source={x:Reference ThisButton}}"
            Background="{Binding ButtonColor, Source={x:Reference ThisButton}}"
            Rotation="45"
            HorizontalOptions="Center"
            VerticalOptions="Center">
        
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference ThisButton}}" />
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow Brush="#000000" Offset="0, 6" Radius="12" Opacity="0.35"/>
        </Border.Shadow>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"
                                  Command="{Binding Command, Source={x:Reference ThisButton}}"
                                  CommandParameter="{Binding CommandParameter, Source={x:Reference ThisButton}}"/>
        </Border.GestureRecognizers>

        <Image Source="{Binding IconSource, Source={x:Reference ThisButton}}"
               WidthRequest="{Binding IconSize, Source={x:Reference ThisButton}}"
               HeightRequest="{Binding IconSize, Source={x:Reference ThisButton}}"
               Aspect="AspectFit"
               Rotation="-45"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
    </Border>
</ContentView>
