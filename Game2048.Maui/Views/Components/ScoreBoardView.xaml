<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Game2048.Maui.Views.Components.ScoreBoardView"
             xmlns:vm="clr-namespace:Game2048.Maui.ViewModels"
             xmlns:lang="clr-namespace:Game2048.Maui.Resources.Localization"
             x:DataType="vm:GameViewModel">

    <Grid ColumnDefinitions="*, *"
          ColumnSpacing="15"
          HorizontalOptions="Fill">
        
        <Border Background="{DynamicResource ScoreBoardBGColor}" 
                Padding="15,5"
                StrokeThickness="3"
                Stroke="{DynamicResource ScoreBoardBorderColor}"
                StrokeShape="RoundRectangle 8"
                Grid.Column="0">

            <VerticalStackLayout HorizontalOptions="Center">

                <Label Text="{x:Static lang:AppResources.Game_ScoreBoard_score_label}" 
                        FontSize="24" 
                        FontFamily="MontBold"  
                        HorizontalOptions="Center" 
                        TextColor="{DynamicResource ScoreBoardTextColor}"/>

                <Label Text="{Binding Score}" 
                        x:Name="ActualScoreLabel"
                        FontSize="24" 
                        FontFamily="RubikBold"  
                        HorizontalOptions="Center"
                        Padding="5, 0, 5, 0"
                        TextColor="{DynamicResource ScoreBoardNumColor}"/>
            </VerticalStackLayout>
        </Border>
        
        <Border Background="{DynamicResource ScoreBoardBGColor}" 
                Padding="15,5"
                StrokeThickness="3"
                Stroke="{DynamicResource ScoreBoardBorderColor}"
                StrokeShape="RoundRectangle 8"
                Grid.Column="1">

            <VerticalStackLayout HorizontalOptions="Center">

                <Label Text="{x:Static lang:AppResources.Game_ScoreBoard_best_score_label}" 
                       FontSize="24" 
                       FontFamily="MontBold"  
                       HorizontalOptions="Center" 
                       TextColor="{DynamicResource ScoreBoardTextColor}"/>

                <Label Text="{Binding BestScore}" 
                       x:Name="BestScoreLabel"
                       FontSize="24" 
                       FontFamily="RubikBold"  
                       HorizontalOptions="Center"
                       Padding="5, 0, 5, 0"
                       TextColor="{DynamicResource ScoreBoardNumColor}"/>

            </VerticalStackLayout>
        </Border>
    </Grid>
    

</ContentView>
