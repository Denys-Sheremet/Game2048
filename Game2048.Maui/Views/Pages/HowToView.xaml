<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Game2048.Maui.ViewModels"
             xmlns:lang="clr-namespace:Game2048.Maui.Resources.Localization"
             xmlns:item="clr-namespace:Game2048.Maui.ViewModels.Items"
             xmlns:comp="clr-namespace:Game2048.Maui.Views.Components"
             x:Class="Game2048.Maui.Views.Pages.HowToView"
             x:DataType="vm:HowToViewModel"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBackgroundColor}">

    <Grid x:Name="PageContainer"
          VerticalOptions="Fill"
          HorizontalOptions="Fill"
          Background="{DynamicResource PageBackgroundColor}"
          IsVisible="False">

        <Grid RowDefinitions="Auto, *, Auto"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            
            <Grid ColumnDefinitions="*, 6*, *" RowDefinitions="Auto" Grid.Row="0" Grid.Column="0" Margin="0, 15, 0, 0">
                <Button x:Name="BackToMenuBtn"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="15, 0, 0, 0"
                        WidthRequest="55"
                        HeightRequest="55"
                        FontFamily="FontAwesome"
                        Text="&#xf30a;"
                        FontSize="20"    
                        Clicked="OnBack" 
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Style="{StaticResource MainBtnStyle}">

                </Button>

                <Label Text="{x:Static lang:AppResources.HowToPage_title}"
                       Grid.Row="0"
                       Grid.Column="1"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontFamily="RubikSemi"
                       FontSize="30"
                       LineBreakMode="WordWrap"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource MainTitleColor}">
                </Label>
            </Grid>

            <CarouselView Grid.Row="1"
                          ItemsSource="{Binding HowToCards}"
                          Position="0"
                          Loop="False"
                          HorizontalScrollBarVisibility="Never"
                          VerticalScrollBarVisibility="Never"
                          IndicatorView="{x:Reference HowToIndicator}">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="item:HowToCardViewModel">
                        <comp:HowToCardView/>
                    </DataTemplate>
                </CarouselView.ItemTemplate>

            </CarouselView>

            <IndicatorView x:Name="HowToIndicator"
                   Grid.Row="2"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,0,0,25"
                   IndicatorSize="10"
                   IndicatorsShape="Circle"
                   IndicatorColor="{DynamicResource SignsTextColor}"
                   SelectedIndicatorColor="{DynamicResource PreviewTextColor}" />
        </Grid>
        
    </Grid>

    
</ContentPage>