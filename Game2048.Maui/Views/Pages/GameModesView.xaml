<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Game2048.Maui.ViewModels"
             xmlns:comp="clr-namespace:Game2048.Maui.Views.Components"
             xmlns:ovr="clr-namespace:Game2048.Maui.Views.Overlays"
             xmlns:models="clr-namespace:Game2048.Maui.Models"
             xmlns:lang="clr-namespace:Game2048.Maui.Resources.Localization"
             x:Class="Game2048.Maui.Views.Pages.GameModesView"
             x:DataType="vm:GameModesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource GameBackgroundColor}">

    <Grid x:Name="GameModesPageContainer"
          BackgroundColor="{DynamicResource GameBackgroundColor}"
          VerticalOptions="Fill"
          HorizontalOptions="Fill">

        <Grid RowDefinitions="Auto, Auto, *"
              ColumnDefinitions="*"
              RowSpacing="10"
              Padding="0, 25, 0, 10"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Grid ColumnDefinitions="60, *, 60" Grid.Row="0" Grid.Column="0">
                <Button x:Name="BackToMenuBtn"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="15, 0, 0, 0"
                        WidthRequest="55"
                        HeightRequest="55"
                        FontFamily="FontAwesome"
                        Text="&#xf30a;"
                        FontSize="20"    
                        Clicked="OnBackToMenu" 
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Style="{StaticResource MainBtnStyle}">

                </Button>

                <Label Text="{x:Static lang:AppResources.GameModes_title}"
                       Grid.Row="0"
                       Grid.Column="1"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontFamily="RubikSemi"
                       FontSize="40"
                       LineBreakMode="WordWrap"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource MainTitleColor}">
                </Label>
            </Grid>

            <CarouselView Grid.Row="2"
                          Grid.Column="0"
                          ItemsSource="{Binding Modes}"
                          CurrentItem="{Binding SelectedMode}"
                          PeekAreaInsets="40">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameMode">
                        <comp:GameModeCardView
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GameModesViewModel}}, Path=StartGameCommand, x:DataType={x:Type vm:GameModesViewModel}}"
                            CommandParameter="{Binding ModeType}"/>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
                
            </CarouselView>
        
        </Grid>
    </Grid>
</ContentPage>