<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Game2048.Maui.ViewModels"
             xmlns:item="clr-namespace:Game2048.Maui.ViewModels.Items"
             xmlns:lang="clr-namespace:Game2048.Maui.Resources.Localization"
             x:Class="Game2048.Maui.Views.Pages.ProfilePageView"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBackgroundColor}"
             x:DataType="vm:ProfilePageViewModel">

    <Grid x:Name="PageContainer"
          VerticalOptions="Fill"
          HorizontalOptions="Fill"
          Background="{DynamicResource PageBackgroundColor}">

        <Grid RowDefinitions="Auto, *"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <Grid ColumnDefinitions="60, *, 60" RowDefinitions="Auto, Auto" Grid.Row="0" Grid.Column="0">
                <Button x:Name="BackToMenuBtn"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="15, 0, 0, 0"
                        WidthRequest="55"
                        HeightRequest="55"
                        FontFamily="FontAwesome"
                        Text="&#xf30a;"
                        FontSize="20"    
                        Clicked="OnBack" 
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Style="{StaticResource MainBtnStyle}">

                </Button>

                <Label Text="{x:Static lang:AppResources.ProfilePage_title}"
                       Grid.Row="0"
                       Grid.Column="1"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontFamily="RubikSemi"
                       FontSize="30"
                       LineBreakMode="WordWrap"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource MainTitleColor}">
                </Label>
            </Grid>

            <ScrollView Grid.Row="1"
                        VerticalScrollBarVisibility="Never"
                        HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="16"
                                     Padding="16, 6, 16, 24"
                                     HorizontalOptions="Fill">
                    <!-- Player name -->

                    <Border x:Name="NameBorder"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill"
                            Padding="25, 15"
                            StrokeShape="RoundRectangle 13"
                            StrokeThickness="3"
                            Stroke="{DynamicResource MainBorderColor}"
                            Style="{StaticResource ProfilePreviewBGStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardTapped" />
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0, 6"
                                    Radius="8"
                                    Opacity="0.45" />
                        </Border.Shadow>


                        <Label x:Name="ProfileNameLabel"
                                Grid.Row="0"
                                Grid.Column="0"
                                FontFamily="RubikBold"
                                FontSize="26"
                                Padding="2"
                                TextColor="{DynamicResource PreviewTextColor}"
                                HorizontalTextAlignment="Start"
                                VerticalTextAlignment="Center"
                                Text="{Binding PlayerName}"/>


                    </Border>

                    <!-- 1. Games Statistics Main Card -->
                    <Border Background="{DynamicResource CardBGColor}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="3"
                            Stroke="{DynamicResource MainBorderColor}"
                            Margin="0, 5"
                            Padding="12">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0, 6"
                                    Radius="8"
                                    Opacity="0.45" />
                        </Border.Shadow>
                        
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">

                            <!-- Games Played Mini Card -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource CardBGColor}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="3"
                                    Stroke="{DynamicResource MainBorderColor}"
                                    Padding="10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCardTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="4" HorizontalOptions="Fill" VerticalOptions="Center">
                                    <Image Source="profile_games_played.svg"
                                           HeightRequest="35"
                                           WidthRequest="35"/>
                                    <Label Text="{x:Static lang:AppResources.ProfilePage_games_played_title}"
                                           FontSize="12"
                                           FontFamily="RubikBold"
                                           TextColor="{DynamicResource MainTitleColor}"
                                           HorizontalTextAlignment="Center" />
                                    <Border HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            StrokeShape="RoundRectangle 15"
                                            Background="{DynamicResource SecondaryFieldBGColor}">
                                        <Label Text="{Binding TotalGamesPlayed}"
                                               FontSize="18"
                                               FontFamily="RubikBold"
                                               TextColor="{DynamicResource MainTextColor}"
                                               HorizontalTextAlignment="Center" />
                                    </Border>
                                    
                                </VerticalStackLayout>
                            </Border>

                            <!-- Games Won Mini Card -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource CardBGColor}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="3"
                                    Stroke="{DynamicResource MainBorderColor}"
                                    Padding="10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCardTapped" />
                                </Border.GestureRecognizers>
                                
                                
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Fill" VerticalOptions="Center">
                                    <Image Source="profile_games_won.svg"
                                           HeightRequest="35"
                                           WidthRequest="35"/>
                                    <Label Text="{x:Static lang:AppResources.ProfilePage_games_won_title}"
                                           FontSize="12"
                                           FontFamily="RubikBold"
                                           TextColor="{DynamicResource MainTitleColor}"
                                           HorizontalTextAlignment="Center" />
                                    <Border HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            Background="{DynamicResource SecondaryFieldBGColor}"
                                            StrokeShape="RoundRectangle 15">
                                        <Label Text="{Binding TotalGamesWon}"
                                               FontSize="18"
                                               FontFamily="RubikBold"
                                               TextColor="{DynamicResource MainTextColor}"
                                               HorizontalTextAlignment="Center" />
                                    </Border>

                                    
                                </VerticalStackLayout>
                            </Border>

                            <!-- Win Rate Mini Card -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource CardBGColor}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="3"
                                    Stroke="{DynamicResource MainBorderColor}"
                                    Padding="10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCardTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="4" HorizontalOptions="Fill" VerticalOptions="Center">
                                    <Image Source="profile_win_rate.svg"
                                           HeightRequest="35"
                                           WidthRequest="35"/>
                                    <Label Text="{x:Static lang:AppResources.ProfilePage_win_rate_title}"
                                           FontSize="12"
                                           FontFamily="RubikBold"
                                           TextColor="{DynamicResource MainTitleColor}"
                                           HorizontalTextAlignment="Center" />
                                    <Border HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            StrokeShape="RoundRectangle 15"
                                            Background="{DynamicResource SecondaryFieldBGColor}">
                                        <Label Text="{Binding WinRatePercentage}"
                                               FontSize="18"
                                               FontFamily="RubikBold"
                                               TextColor="{DynamicResource MainTextColor}"
                                               HorizontalTextAlignment="Center" />
                                    </Border>
                                    
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Total Coins Earned Card -->
                    <Border Background="{DynamicResource CardBGColor}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="3"
                            Stroke="{DynamicResource MainBorderColor}"
                            Padding="12">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0, 6"
                                    Radius="8"
                                    Opacity="0.45" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*, Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Image Source="coin.svg"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       VerticalOptions="Center"/>
                                <Label Text="{x:Static lang:AppResources.ProfilePage_total_coins_label}"
                                       FontSize="16"
                                       FontFamily="RubikBold"
                                       TextColor="{DynamicResource MainTextColor}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding TotalCoinsEarned}"
                                       FontSize="18"
                                       FontFamily="RubikBold"
                                       TextColor="{DynamicResource MainTitleColor}"
                                       VerticalOptions="Center" />
                                
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <!-- 2. Achievements Card -->
                    <Border Background="{DynamicResource CardBGColor}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="3"
                            Stroke="{DynamicResource MainBorderColor}"
                            Padding="12">
                        <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" />
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0, 6"
                                    Radius="8"
                                    Opacity="0.45" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <Image Source="profile_achievements.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"/>
                                    <Label Text="{x:Static lang:AppResources.ProfilePage_achievements_unlocked_label}"
                                               FontSize="16"
                                               FontFamily="RubikBold"
                                               TextColor="{DynamicResource MainTextColor}"
                                               VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Label Grid.Column="1"
                                           Text="{Binding AchievementsCountText}"
                                           FontSize="16"
                                           FontFamily="RubikBold"
                                           TextColor="{DynamicResource MainTitleColor}"
                                           VerticalOptions="Center" />
                            </Grid>

                            <ProgressBar Progress="{Binding AchievementsProgressFraction}"
                                         ProgressColor="{DynamicResource ProgressBarColor}"
                                         HeightRequest="8"
                                         VerticalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Themes Card -->
                    <Border Background="{DynamicResource CardBGColor}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="3"
                            Stroke="{DynamicResource MainBorderColor}"
                            Padding="12">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0, 6"
                                    Radius="8"
                                    Opacity="0.45" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" />
                            </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <Image Source="profile_themes.svg"
                                           WidthRequest="16"
                                           HeightRequest="16"/>
                                    <Label Text="{x:Static lang:AppResources.ProfilePage_themes_collected_label}"
                                               FontSize="16"
                                               FontFamily="RubikBold"
                                               TextColor="{DynamicResource MainTextColor}"
                                               VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Label Grid.Column="1"
                                           Text="{Binding ThemesCountText}"
                                           FontSize="16"
                                           FontFamily="RubikBold"
                                           TextColor="{DynamicResource MainTitleColor}"
                                           VerticalOptions="Center" />
                            </Grid>

                            <ProgressBar Progress="{Binding ThemesProgressFraction}"
                                         ProgressColor="{DynamicResource ProgressBarColor}"
                                         HeightRequest="8"
                                         VerticalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4. High Scores & Records Main Card -->
                    <Border Background="{DynamicResource CardBGColor}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="3"
                            Stroke="{DynamicResource MainBorderColor}"
                            Padding="12">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0, 6"
                                    Radius="8"
                                    Opacity="0.45" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="10">

                            <!-- Top Mini Cards: Highest & Average Score -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">

                                <!-- Highest Score Mini Card -->
                                <Border Grid.Column="0"
                                        Background="{DynamicResource SecondaryFieldBGColor}"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="3"
                                        Stroke="{DynamicResource MainBorderColor}"
                                        Padding="10, 10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="3" VerticalOptions="Center" HorizontalOptions="Center">
                                        <Image Source="profile_best_score.svg"
                                               WidthRequest="20"
                                               HeightRequest="20"/>
                                        <Label Text="{x:Static lang:AppResources.ProfilePage_highest_score_label}"
                                               FontSize="14"
                                               FontFamily="RubikBold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{DynamicResource SignsTextColor}" />
                                        <Label Text="{Binding OverallHighScore}"
                                               FontSize="19"
                                               FontFamily="RubikBold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{DynamicResource MainTextColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Average Score Mini Card -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SecondaryFieldBGColor}"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="3"
                                        Stroke="{DynamicResource MainBorderColor}"
                                        Padding="10, 10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="3" VerticalOptions="Center" HorizontalOptions="Center">
                                        <Image Source="profile_average_score.svg"
                                               WidthRequest="20"
                                               HeightRequest="20"/>
                                        <Label Text="{x:Static lang:AppResources.ProfilePage_average_score_label}"
                                               FontSize="14"
                                               FontFamily="RubikBold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{DynamicResource SignsTextColor}" />
                                        <Label Text="{Binding AverageScore}"
                                               FontSize="19"
                                               FontFamily="RubikBold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{DynamicResource MainTextColor}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <!-- Best mode Mini Card -->
                            <Border Background="{DynamicResource SecondaryFieldBGColor}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="3"
                                    Stroke="{DynamicResource MainBorderColor}"
                                    Padding="10, 10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCardTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="3" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Image Source="profile_best_mode.svg"
                                           WidthRequest="20"
                                           HeightRequest="20"/>
                                    <Label Text="{x:Static lang:AppResources.ProfilePage_best_mode_label}"
                                           FontSize="16"
                                           FontFamily="RubikBold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource SignsTextColor}" />
                                    <Label Text="{Binding BestScoreModeName}"
                                           FontSize="16"
                                           FontFamily="RubikBold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource MainTextColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border Background="{DynamicResource CardBGColor}"
                                    StrokeShape="RoundRectangle 18"
                                    StrokeThickness="3"
                                    Stroke="{DynamicResource MainBorderColor}"
                                    Padding="12"
                                    IsVisible="{Binding IsModeStatsNotEmpty}">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0, 6"
                                    Radius="8"
                                    Opacity="0.45" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="8"
                                             BindableLayout.ItemsSource="{Binding ModeStats}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="item:ModeStatViewModel">
                                            <Border Background="{DynamicResource SecondaryFieldBGColor}"
                                                    StrokeShape="RoundRectangle 12"
                                                    StrokeThickness="3"
                                                    Stroke="{DynamicResource MainBorderColor}"
                                                    Padding="12, 10"
                                                    HeightRequest="70">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnCardTapped" />
                                                </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="Auto, *, *" InputTransparent="True">
                                                    <Image Source="{Binding RatingIcon}"
                                                           Grid.Column="0"
                                                           HeightRequest="35"
                                                           WidthRequest="35"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="Start"/>
                                                    <Label Text="{Binding ModeName}"
                                                           Grid.Column="1"
                                                           FontSize="16"
                                                           FontFamily="RubikBold"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="Start"
                                                           LineBreakMode="WordWrap"
                                                           Margin="25, 0, 0, 0"
                                                           TextColor="{DynamicResource SignsTextColor}"/>
                                                    <Label Text="{Binding HighestScore}"
                                                           Grid.Column="2"
                                                           FontSize="16"
                                                           FontFamily="RubikBold"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="End"
                                                           Margin="0, 0, 25, 0"
                                                           TextColor="{DynamicResource MainTextColor}"/>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                            
                        

                </VerticalStackLayout>
            </ScrollView>


        </Grid>
        
        
    </Grid>
    
</ContentPage>