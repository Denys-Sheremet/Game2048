<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:Game2048.Maui.Views.Components"
             xmlns:ovr="clr-namespace:Game2048.Maui.Views.Overlays"
             xmlns:vm="clr-namespace:Game2048.Maui.ViewModels"
             xmlns:lang="clr-namespace:Game2048.Maui.Resources.Localization"
             x:Class="Game2048.Maui.Views.Pages.GameView"
             x:DataType="vm:GameViewModel"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBackgroundColor}">

    <Grid x:Name="GamePageContainer"
          Background="{DynamicResource PageBackgroundColor}"
          VerticalOptions="Fill"
          HorizontalOptions="Fill">
        
    
        <Grid x:Name="PageGrid" 
              RowDefinitions="Auto, *, Auto"
              IsVisible="False">

            <!-- Info block with score -->
            <Grid x:Name="InfoBlockWrapper" 
                  Grid.Row="0" 
                  ColumnDefinitions="*, *, *, *" 
                  RowDefinitions="Auto, Auto" 
                  ColumnSpacing="20" 
                  Padding="15"
                  HorizontalOptions="Fill"
                  IsEnabled="{Binding IsActiveGame}">

                <Button x:Name="BackBtn" 
                        Grid.Column="0" 
                        WidthRequest="55"
                        HeightRequest="55"
                        FontFamily="FontAwesome"
                        Text="&#xf30a;"
                        FontSize="20"    
                        Clicked="OnBackToMenu" 
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Style="{StaticResource MainBtnStyle}"/>

                <Label Grid.Column="1" 
                       Grid.ColumnSpan="2" 
                       Text="{x:Static lang:AppResources.Game_title}" 
                       FontSize="55" 
                       FontFamily="RubikBold" 
                       HorizontalOptions="Center" 
                       TextColor="{DynamicResource LogoNumColor}" />

                <Grid Grid.Column="0" 
                      Grid.ColumnSpan="4" 
                      Grid.Row="1" 
                      ColumnDefinitions="*" 
                      Margin="0, 15, 0, 0" 
                      ColumnSpacing="20">

                    <comp:ScoreBoardView Grid.Column="0" VerticalOptions="Center"/>
                </Grid>
            </Grid>

            <!-- Game field block with acual gameplay -->
            <ContentView x:Name="FieldBlockWrapper" 
                         Grid.Row="1" 
                         HorizontalOptions="Fill" 
                         VerticalOptions="Fill"
                         SizeChanged="OnFieldWrapperSizeChanged">

                <Border x:Name="GameFrame" 
                        Padding="0" 
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8" 
                        Background="{DynamicResource GameFieldBackgroundColor}">

                    <Grid>

                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                        </Grid.GestureRecognizers>

                        <AbsoluteLayout x:Name="BackgroundGridLayout"/>

                        <AbsoluteLayout x:Name="GameGridLayout" />

                    </Grid>
                
                </Border>
            
            </ContentView>

            <!-- Control buttons block (Undo, settings) -->
            <Grid x:Name="ButtonsBlockWrapper" 
                  Grid.Row="2" 
                  ColumnDefinitions="*, *" 
                  ColumnSpacing="20" 
                  Padding="15, 40" 
                  VerticalOptions="End"
                  IsEnabled="{Binding IsActiveGame}">

                <!-- Settings button -->
                <Button Grid.Column="0" 
                        Text="{x:Static lang:AppResources.Game_settings_btn_text}" 
                        Command="{Binding OpenSettingsCommand}"
                        FontSize="24" 
                        Style="{StaticResource MainBtnStyle}" 
                        FontFamily="MontBold">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding IsUndoEnabled}"
                                     Value="False"> 
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Undo button and badge container -->
                <Grid Grid.Column="1"
                      IsVisible="{Binding IsUndoEnabled}">

                    <Button Text="{x:Static lang:AppResources.Game_undo_btn_text}" 
                            Command="{Binding UndoCommand}"
                            x:Name="UndoBtn"
                            Clicked="OnUndoButtonClicked"
                            FontSize="24" 
                            Style="{StaticResource MainBtnStyle}"
                            FontFamily="MontBold"/>

                    <!-- Undo count badge -->
                    <Border x:Name="UndoCountBadge"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            TranslationX="10"
                            TranslationY="-10"
                            WidthRequest="35"
                            HeightRequest="35"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="2"
                            Stroke="{DynamicResource GameBackgroundColor}"
                            Background="{DynamicResource LogoNumColor}"
                            InputTransparent="True"
                            ZIndex="2">

                        <Label Text="{Binding HistoryCount}"
                               FontSize="16"
                               FontFamily="RubikBold"
                               TextColor="{DynamicResource GameBackgroundColor}"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               InputTransparent="True"/>
                    </Border>
                </Grid>

            </Grid>

        </Grid>

        <Grid x:Name="EndOfGameOverlay"
              IsVisible="{Binding IsBoardBlocked}"
              BackgroundColor="#80000000"
              InputTransparent="False"
              CascadeInputTransparent="False"
              ZIndex="10"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
                <PanGestureRecognizer />
                <SwipeGestureRecognizer Direction="Up,Down,Left,Right" />
            </Grid.GestureRecognizers>

            <ovr:GameOverOverlayView x:Name="GameOverOverlay" IsVisible="{Binding IsGameOver}"/>
            <ovr:VictoryOverlayView x:Name="VictoryOverlay" IsVisible="{Binding IsVictory}"/>
            <ovr:SettingsView x:Name="Settings" IsVisible="{Binding IsSettings}"/>
        </Grid>


        <ovr:AchievementToastView x:Name="AchievementToast" 
              ZIndex="100" 
              InputTransparent="True"/>
    </Grid>
</ContentPage>