<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Game2048.Maui.Views.Overlays.AchievementToastView"
             x:Name="AchievementToastOverlay">

    <Border x:Name="ToastContainer"
            IsVisible="False"
            VerticalOptions="Start"
            HorizontalOptions="Center"
            Margin="0, 0, 0, 0"
            Padding="12, 12, 20, 12"
            StrokeShape="RoundRectangle 20"
            BackgroundColor="{DynamicResource GameFieldBackgroundColor}"
            InputTransparent="True"
            TranslationY="0">
        <Border.Shadow>
            <Shadow Brush="Black"
                Offset="0,10"
                Radius="15"
                Opacity="0.6" />
        </Border.Shadow>

        <Grid ColumnDefinitions="Auto, *"
              x:Name="ToastContentGrid">

            <Border Grid.Column="0"
                    HeightRequest="50" 
                    WidthRequest="50"
                    StrokeShape="RoundRectangle 25"
                    StrokeThickness="0"
                    Padding="0"
                    Margin="0, 0, 15, 0">
                <Image x:Name="AchievementIcon"
                       Aspect="AspectFill" />
            </Border>

            <VerticalStackLayout Grid.Column="1" 
                                 VerticalOptions="Center" 
                                 Spacing="2">

                <Label x:Name="AchievementTitleLabel"
                       FontFamily="RubikBold"
                       FontSize="16"
                       TextColor="{DynamicResource ScoreBoardTextColor}" />

                <Label x:Name="AchievementDescLabel"
                       FontFamily="MontBold"
                       FontSize="13"
                       TextColor="{DynamicResource LogoNumColor}" />

            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>