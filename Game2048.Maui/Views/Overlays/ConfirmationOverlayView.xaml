<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Game2048.Maui.ViewModels"
             xmlns:lang="clr-namespace:Game2048.Maui.Resources.Localization"
             x:DataType="vm:SettingsViewModel"
             x:Class="Game2048.Maui.Views.Overlays.ConfirmationOverlayView"
             x:Name="ConfirmationOverlay">

    <Border VerticalOptions="Center"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="2"
            Stroke="{DynamicResource MainBorderColor}"
            Padding="15"
            BackgroundColor="{DynamicResource GameFieldBackgroundColor}"
            WidthRequest="350">

        
        <VerticalStackLayout Spacing="15" HorizontalOptions="Center" VerticalOptions="Center">
            <Grid ColumnDefinitions="40, *, 40" Margin="0, 0, 0, 10">
                <Label Text="{x:Static lang:AppResources.ConfirmationOverlay_title}"
                       Grid.Column="1"
                       FontFamily="RubikBold"
                       FontSize="26"
                       TextColor="{DynamicResource ScoreBoardTextColor}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       LineBreakMode="NoWrap">

                </Label>
                <Button Grid.Column="2"
                        Text="&#xf00d;" 
                        FontFamily="FontAwesome"
                        FontSize="24"
                        TextColor="{DynamicResource ScoreBoardTextColor}"
                        BackgroundColor="Transparent"
                        Padding="0"
                        HeightRequest="40"
                        WidthRequest="40"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Clicked="OnCloseConfirmationOverlay" />
            </Grid>

                <Label Text="{x:Static lang:AppResources.ConfirmationOverlay_desc}"
                       FontFamily="RubikSemi"
                       FontSize="16"
                       TextColor="Red"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       Margin="0, 0, 0, 10">
                
                </Label>

                <Button x:Name="ConfirmBtn"
                    Style="{StaticResource MainBtnStyle}"
                    Text="{x:Static lang:AppResources.ConfirmationOverlay_confirm_btn_text}"
                    FontFamily="MontBold"
                    FontSize="20"
                    Command="{Binding ConfirmAndRestartCommand}">

                </Button>



            </VerticalStackLayout>
        


    </Border>

</ContentView>
