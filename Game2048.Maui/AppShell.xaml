<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Game2048.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Game2048.Maui.Views.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="2048"
    Shell.TabBarIsVisible="False">

    <ShellContent ContentTemplate="{DataTemplate pages:IntroPage}" x:Name="Intro" Route="IntroPage"/>
    <ShellContent ContentTemplate="{DataTemplate pages:LangSelectPage}" x:Name="LangSelect" Route="LangSelectPage"/>
    <ShellContent ContentTemplate="{DataTemplate pages:MainMenuView}" x:Name="MainMenu" Route="MainMenuPage"/>
    <ShellContent ContentTemplate="{DataTemplate pages:GameView}" x:Name="Game" Route="GamePage"/>
    <ShellContent ContentTemplate="{DataTemplate pages:AchievementsView}" x:Name="Achievements" Route="AchievementsPage"/>
    <ShellContent ContentTemplate="{DataTemplate pages:GameModesView}" x:Name="GameModes" Route="GameModesPage"/>
    <ShellContent ContentTemplate="{DataTemplate pages:SettingsPageView}" x:Name="Settings" Route="SettingsPage"/>

</Shell>
