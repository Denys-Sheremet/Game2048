<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Game2048.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Game2048.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="2048">
    
    <ShellContent ContentTemplate="{DataTemplate views:IntroPage}" Route="IntroPage"/>
    <ShellContent ContentTemplate="{DataTemplate views:MainMenuView}" Route="MainMenuPage"/>
    <ShellContent ContentTemplate="{DataTemplate views:GameView}" Route="ClassicGamePage"/>

</Shell>
